{
  "name": "capaxion-desktop",
  "version": "0.4.8",
  "private": true,
  "author": "kiki720-w",
  "description": "CAPAXION Manufacturing Decision OS desktop client",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env CAPAXION_DESKTOP_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "ui:smoke": "node scripts/ui-smoke.cjs",
    "desktop:build": "pnpm build && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "png-to-ico": "^3.0.2",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.capaxion.desktop",
    "productName": "CAPAXION",
    "artifactName": "CAPAXION-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/capaxion-icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        "portable"
      ]
    }
  }
}
