POSTGRES_PASSWORD=change-me
AUTONOMOUS_MES_DATABASE_URL=postgresql+psycopg://mes:change-me@localhost:5432/agentic_mes
AUTONOMOUS_MES_STORAGE_BACKEND=postgresql
AUTONOMOUS_MES_LOG_LEVEL=INFO
# Optional: explanation-only cloud model. Never commit a real key.
AUTONOMOUS_MES_DEEPSEEK_API_KEY=
AUTONOMOUS_MES_DEEPSEEK_MODEL=deepseek-v4-flash
AUTONOMOUS_MES_DEEPSEEK_BASE_URL=https://api.deepseek.com
AUTONOMOUS_MES_DEEPSEEK_TIMEOUT_SECONDS=12
# Experimental only. Keep false for the Stage-1 L2 baseline.
AUTONOMOUS_MES_AGENT_L3_EXECUTION_ENABLED=false
AUTONOMOUS_MES_AGENT_L3_APPROVER_IDS=
AUTONOMOUS_MES_DEPLOYMENT_MODE=FACTORY_EDGE
AUTONOMOUS_MES_ORGANIZATION_ID=ORG-DEMO
AUTONOMOUS_MES_FACTORY_ID=FACTORY-DEMO
# DEV keeps the local dashboard passwordless. Set OIDC outside local development.
AUTONOMOUS_MES_AUTH_MODE=DEV
AUTONOMOUS_MES_OIDC_ISSUER=
AUTONOMOUS_MES_OIDC_AUDIENCE=agentic-mes-api
AUTONOMOUS_MES_OIDC_JWKS_URL=
AUTONOMOUS_MES_OIDC_WEB_CLIENT_ID=agentic-mes-web
AUTONOMOUS_MES_OIDC_ROLES_CLAIM=realm_access.roles
AUTONOMOUS_MES_OIDC_FACTORY_IDS_CLAIM=factory_ids
AUTONOMOUS_MES_DEV_SUBJECT_ID=demo-supervisor
AUTONOMOUS_MES_DEV_QUALITY_SUBJECT_ID=demo-quality-manager
AUTONOMOUS_MES_DEV_QUALITY_DISPLAY_NAME=Demo Quality Manager
AUTONOMOUS_MES_DEV_PLANNER_SUBJECT_ID=demo-planner
AUTONOMOUS_MES_DEV_PLANNER_DISPLAY_NAME=Demo Planner
AUTONOMOUS_MES_DEV_DISPLAY_NAME=Demo Supervisor
AUTONOMOUS_MES_DEV_ROLES=SUPERVISOR,PLANNER,OPERATOR,QUALITY,MASTER_DATA_ADMIN
AUTONOMOUS_MES_DEV_FACTORY_IDS=FACTORY-DEMO
# Optional inbound connector credentials. Generate a unique secret per deployment.
AUTONOMOUS_MES_CONNECTOR_KEY_ID=
AUTONOMOUS_MES_CONNECTOR_HMAC_SECRET=
AUTONOMOUS_MES_CONNECTOR_MAX_CLOCK_SKEW_SECONDS=300
