POSTGRES_PASSWORD=change-me
AUTONOMOUS_MES_DATABASE_URL=postgresql+psycopg://mes:change-me@localhost:5432/agentic_mes
AUTONOMOUS_MES_STORAGE_BACKEND=postgresql
AUTONOMOUS_MES_LOG_LEVEL=INFO
# Optional: provider-neutral, explanation-only model gateway. Never commit a real key.
AUTONOMOUS_MES_MODEL_PROVIDER=DEEPSEEK
AUTONOMOUS_MES_MODEL_API_KEY=
AUTONOMOUS_MES_MODEL_NAME=deepseek-v4-flash-vision-exp
AUTONOMOUS_MES_MODEL_BASE_URL=https://api.deepseek.com
AUTONOMOUS_MES_MODEL_TIMEOUT_SECONDS=12
# Legacy DeepSeek names remain supported for existing deployments.
AUTONOMOUS_MES_DEEPSEEK_API_KEY=
AUTONOMOUS_MES_DEEPSEEK_MODEL=deepseek-v4-flash
AUTONOMOUS_MES_DEEPSEEK_BASE_URL=https://api.deepseek.com
AUTONOMOUS_MES_DEEPSEEK_TIMEOUT_SECONDS=12
# Experimental only. Keep false for the Stage-1 L2 baseline.
AUTONOMOUS_MES_AGENT_L3_EXECUTION_ENABLED=false
AUTONOMOUS_MES_AGENT_L3_APPROVER_IDS=
# Bounded L3 scheduling Agent: may create and submit plans, never approve or publish.
AUTONOMOUS_MES_SCHEDULING_AGENT_ENABLED=true
AUTONOMOUS_MES_SCHEDULING_AGENT_AUTO_SUBMIT=true
AUTONOMOUS_MES_SCHEDULING_AGENT_WORKSHOP_IDS=WS-MACH-01
AUTONOMOUS_MES_SCHEDULING_AGENT_HORIZON_DAYS=10
AUTONOMOUS_MES_SCHEDULING_AGENT_DEFAULT_MINUTES_PER_UNIT=30
AUTONOMOUS_MES_SCHEDULING_AGENT_USE_OVERTIME=false
# Enables the legacy built-in MES write paths for demos/tests only.
AUTONOMOUS_MES_SIMULATOR_MODE=false
AUTONOMOUS_MES_DEPLOYMENT_MODE=FACTORY_EDGE
AUTONOMOUS_MES_ORGANIZATION_ID=ORG-DEMO
AUTONOMOUS_MES_FACTORY_ID=FACTORY-DEMO
# DEV keeps the local dashboard passwordless. Set OIDC outside local development.
AUTONOMOUS_MES_AUTH_MODE=DEV
AUTONOMOUS_MES_OIDC_ISSUER=
AUTONOMOUS_MES_OIDC_AUDIENCE=capaxion-api
AUTONOMOUS_MES_OIDC_JWKS_URL=
AUTONOMOUS_MES_OIDC_WEB_CLIENT_ID=capaxion-web
AUTONOMOUS_MES_OIDC_ROLES_CLAIM=realm_access.roles
AUTONOMOUS_MES_OIDC_FACTORY_IDS_CLAIM=factory_ids
AUTONOMOUS_MES_DEV_SUBJECT_ID=demo-supervisor
AUTONOMOUS_MES_DEV_QUALITY_SUBJECT_ID=demo-quality-manager
AUTONOMOUS_MES_DEV_QUALITY_DISPLAY_NAME=Demo Quality Manager
AUTONOMOUS_MES_DEV_PLANNER_SUBJECT_ID=demo-planner
AUTONOMOUS_MES_DEV_PLANNER_DISPLAY_NAME=Demo Planner
AUTONOMOUS_MES_DEV_DISPLAY_NAME=Demo Supervisor
AUTONOMOUS_MES_DEV_ROLES=SUPERVISOR,PLANNER,OPERATOR,QUALITY,MASTER_DATA_ADMIN
AUTONOMOUS_MES_DEV_FACTORY_IDS=FACTORY-DEMO
# Optional inbound connector credentials. Generate a unique secret per deployment.
AUTONOMOUS_MES_CONNECTOR_KEY_ID=
AUTONOMOUS_MES_CONNECTOR_HMAC_SECRET=
AUTONOMOUS_MES_CONNECTOR_MAX_CLOCK_SKEW_SECONDS=300

# Independent server-owned egress allowlists; comma-separated exact base URLs.
AUTONOMOUS_MES_MODEL_LOCAL_ENDPOINTS=http://127.0.0.1:11434/v1
AUTONOMOUS_MES_MODEL_CLOUD_ENDPOINTS=https://api.deepseek.com
AUTONOMOUS_MES_BUSINESS_ENDPOINTS=

# L4 scheduling starts in shadow mode. LOCAL_CORE publishes only to CAPAXION's local plan store.
AUTONOMOUS_MES_SCHEDULING_AUTONOMY_MODE=SHADOW
AUTONOMOUS_MES_SCHEDULING_AUTONOMY_LOOP_ENABLED=false
AUTONOMOUS_MES_SCHEDULING_AUTONOMY_POLL_SECONDS=60
AUTONOMOUS_MES_SCHEDULING_AUTONOMY_EXECUTION_TARGET=NONE
AUTONOMOUS_MES_SCHEDULING_AUTONOMY_MAX_ASSIGNMENTS=50
AUTONOMOUS_MES_SCHEDULING_AUTONOMY_MAX_AFFECTED_ORDERS=20
AUTONOMOUS_MES_SCHEDULING_AUTONOMY_MAX_LATE_ORDERS=0
AUTONOMOUS_MES_SCHEDULING_AUTONOMY_MAX_SHORTAGES=0
AUTONOMOUS_MES_SCHEDULING_AUTONOMY_MAX_SNAPSHOT_AGE_SECONDS=300
AUTONOMOUS_MES_SCHEDULING_AUTONOMY_ALLOW_OVERTIME=false
AUTONOMOUS_MES_SCHEDULING_AUTONOMY_REQUIRE_EXTERNAL_SNAPSHOT=true
AUTONOMOUS_MES_SCHEDULING_AUTONOMY_REQUIRE_PROCESS_STANDARDS=true
